# mobile-automation settings. Copy to .env (git-ignored) and fill in. Values live only in .env.

# Appium server. The skill starts it when it is not running.
APPIUM_URL=http://127.0.0.1:4723

# Platform of this suite: android | ios
PLATFORM=android

# The real device (adb serial for Android, UDID for an iPhone). Empty = the first connected real device.
DEVICE_UDID=

# App under test: a file (APK / IPA) and/or the id of the installed app (package name / bundle id).
APP_PATH=
APP_ID=
# Android only, when the app is not started from APP_PATH (optional)
ANDROID_APP_ACTIVITY=

# How the Flutter layer is reached:
#   integration = test build with appium_flutter_server (Flutter Integration Driver)
#   native      = fallback through the native accessibility tree (UiAutomator2 / XCUITest)
FLUTTER_MODE=integration

# How long to wait for a control or message, in ms (state waits, never fixed sleeps)
WAIT_TIMEOUT_MS=15000

# One automatic re-run of a failed case (separates intermittent results)
RETRIES=1

# iOS real device only (WebDriverAgent signing)
IOS_XCODE_ORG_ID=
IOS_XCODE_SIGNING_ID=iPhone Developer
IOS_UPDATED_WDA_BUNDLE_ID=

# Credentials: one pair per role of the test plan (upper-case role slug). Names are mapped in
# test-data/credentials.map.json. Never copy these values anywhere else.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional: Jira REST settings for file-bugs-to-jira (attachment upload, assignable users).
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
