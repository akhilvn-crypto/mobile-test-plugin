{
  "name": "mobile-automation",
  "private": true,
  "type": "module",
  "description": "Appium + WebdriverIO + TypeScript automation for Flutter apps on real devices (execute-mobile-test-cases)",
  "scripts": {
    "test:android": "wdio run ./wdio.android.conf.ts",
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@wdio/cli": "^9.31.0",
    "@wdio/globals": "^9.31.0",
    "@wdio/local-runner": "^9.31.0",
    "@wdio/mocha-framework": "^9.31.0",
    "@wdio/spec-reporter": "^9.31.0",
    "@wdio/types": "^9.31.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "webdriverio": "^9.31.0"
  }
}
